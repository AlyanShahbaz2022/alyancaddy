generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// The entire site content document is stored as a single JSONB row.
// The shape/validation is owned by the Zod `contentSchema` in
// src/types/content.ts — this table just persists the parsed object.
model SiteContent {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

// A quote/contact-form submission from a site visitor.
model Submission {
  id        String   @id @default(cuid())
  name      String
  email     String
  service   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
